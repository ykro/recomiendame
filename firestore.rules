rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'tu-correo@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidRecommendation(data) {
      return data.keys().hasAll([
        'name', 'category', 'zone', 'price', 'rating',
        'whatToOrder', 'comment', 'authorId', 'authorName',
        'status', 'reviewCount', 'ratingSum', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'name', 'category', 'zone', 'price', 'rating',
        'whatToOrder', 'comment', 'authorId', 'authorName',
        'status', 'reviewCount', 'ratingSum', 'createdAt'
      ]) &&
      data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
      data.category in ['comer', 'cafe', 'salir', 'paseo'] &&
      data.zone is string && data.zone.size() > 0 && data.zone.size() <= 100 &&
      data.price in [1, 2, 3] &&
      data.rating in [1, 2, 3, 4, 5] &&
      data.whatToOrder is string && data.whatToOrder.size() <= 200 &&
      data.comment is string && data.comment.size() <= 1000 &&
      data.authorId is string && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.authorName is string && data.authorName.size() <= 100 &&
      data.status in ['publicada', 'reportada', 'oculta'] &&
      data.reviewCount is number && data.reviewCount >= 0 &&
      data.ratingSum is number && data.ratingSum >= 0 &&
      data.createdAt is timestamp;
    }

    function isValidReview(data, recId) {
      return data.keys().hasAll([
        'recommendationId', 'authorId', 'authorName', 'rating', 'comment', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'recommendationId', 'authorId', 'authorName', 'rating', 'comment', 'createdAt'
      ]) &&
      data.recommendationId == recId &&
      data.authorId is string && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.authorName is string && data.authorName.size() <= 100 &&
      data.rating in [1, 2, 3, 4, 5] &&
      data.comment is string && data.comment.size() <= 1000 &&
      data.createdAt is timestamp;
    }

    function isValidSavedPlace(data, recId) {
      return data.keys().hasAll([
        'recommendationId', 'name', 'category', 'zone', 'price', 'savedAt'
      ]) &&
      data.keys().hasOnly([
        'recommendationId', 'name', 'category', 'zone', 'price', 'savedAt'
      ]) &&
      data.recommendationId == recId &&
      data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
      data.category in ['comer', 'cafe', 'salir', 'paseo'] &&
      data.zone is string && data.zone.size() > 0 && data.zone.size() <= 100 &&
      data.price in [1, 2, 3] &&
      data.savedAt is timestamp;
    }

    // Helper: reviewCount y ratingSum solo cambian junto con la reseña de quien escribe en la misma transacción
    function isReviewCountSync(recommendationId) {
      let reviewPath = /databases/$(database)/documents/recommendations/$(recommendationId)/reviews/$(request.auth.uid);
      let wasReview = exists(reviewPath);
      let hasReviewAfter = existsAfter(reviewPath);
      return (
        // Crear reseña: antes no existía, existe después
        (!wasReview && hasReviewAfter &&
         incoming().reviewCount == existing().reviewCount + 1 &&
         incoming().ratingSum == existing().ratingSum + getAfter(reviewPath).data.rating) ||
        // Editar reseña: existía antes y después
        (wasReview && hasReviewAfter &&
         incoming().reviewCount == existing().reviewCount &&
         incoming().ratingSum == existing().ratingSum + (getAfter(reviewPath).data.rating - get(reviewPath).data.rating)) ||
        // Borrar reseña: existía antes, no existe después
        (wasReview && !hasReviewAfter &&
         incoming().reviewCount == existing().reviewCount - 1 &&
         incoming().ratingSum == existing().ratingSum - get(reviewPath).data.rating)
      );
    }

    function isListMember(listId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.memberIds;
    }

    match /admins/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // 5. Nadie lee ni escribe el Quiero ir de otra persona (tampoco la administradora)
    match /users/{userId}/saved/{savedId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(savedId) &&
                       isValidSavedPlace(incoming(), savedId) &&
                       incoming().savedAt == request.time;

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(savedId) &&
                       isValidSavedPlace(incoming(), savedId);

      allow delete: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(savedId);
    }

    match /recommendations/{recommendationId} {
      // 1. Visitante lee publicadas y reportadas. Oculto solo administradora
      allow get: if resource.data.status in ['publicada', 'reportada'] ||
                    (isAdmin() && resource.data.status == 'oculta');

      // 8. Consultas con filtros: feed (publicadas y reportadas), perfil (authorId y status) y moderacion (reportada y oculta)
      allow list: if resource.data.status in ['publicada', 'reportada'] ||
                     (isAdmin() && resource.data.status in ['reportada', 'oculta']);

      allow create: if isSignedIn() &&
                       isValidId(recommendationId) &&
                       isValidRecommendation(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().status == 'publicada' &&
                       incoming().reviewCount == 0 &&
                       incoming().ratingSum == 0 &&
                       incoming().createdAt == request.time;

      allow update: if isSignedIn() &&
                       isValidId(recommendationId) &&
                       isValidRecommendation(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // 2. Solo la autora edita su recomendación (no cambia status ni contadores)
                         (existing().authorId == request.auth.uid &&
                          incoming().status == existing().status &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'name', 'category', 'zone', 'price', 'rating',
                            'whatToOrder', 'comment', 'authorName'
                          ])) ||
                         // 3. reviewCount y ratingSum solo cambian junto con la reseña de quien escribe, en la misma transacción y exactamente por su calificación
                         (existing().authorId != request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['reviewCount', 'ratingSum']) &&
                          isReviewCountSync(recommendationId)) ||
                         // Reportar: solo cambia status de publicada a reportada
                         (existing().authorId != request.auth.uid &&
                          existing().status == 'publicada' &&
                          incoming().status == 'reportada' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
                         // 4. La administradora solo cambia status: no edita datos ni contadores de nadie
                         (isAdmin() &&
                          incoming().status in ['publicada', 'oculta'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status']))
                       );

      // 2. Solo la autora borra su recomendacion. La administradora no borra lo de otras personas.
      allow delete: if isSignedIn() &&
                       isValidId(recommendationId) &&
                       existing().authorId == request.auth.uid;

      // Subcolección de reseñas
      match /reviews/{reviewId} {
        // 1. Si la recomendación está oculta, sus reseñas dejan de ser públicas (solo administradora las lee)
        allow read: if get(/databases/$(database)/documents/recommendations/$(recommendationId)).data.status in ['publicada', 'reportada'] ||
                       isAdmin();

        allow create: if isSignedIn() &&
                         isValidId(reviewId) &&
                         reviewId == request.auth.uid &&
                         isValidReview(incoming(), recommendationId) &&
                         incoming().authorId == request.auth.uid &&
                         incoming().createdAt == request.time &&
                         get(/databases/$(database)/documents/recommendations/$(recommendationId)).data.authorId != request.auth.uid;

        // 2. Solo la autora edita su reseña
        allow update: if isSignedIn() &&
                         isValidId(reviewId) &&
                         reviewId == request.auth.uid &&
                         existing().authorId == request.auth.uid &&
                         isValidReview(incoming(), recommendationId) &&
                         incoming().authorId == existing().authorId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'rating', 'comment', 'authorName'
                         ]);

        // 2. Solo la autora borra su reseña (nadie más, tampoco administradora)
        allow delete: if isSignedIn() &&
                         isValidId(reviewId) &&
                         reviewId == request.auth.uid &&
                         existing().authorId == request.auth.uid;
      }
    }

    // 7. Quien no es miembro no lee una lista, sus lugares ni sus votos (tampoco la administradora)
    match /lists/{listId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn() &&
                       isValidId(listId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().memberIds.size() == 1 &&
                       incoming().memberIds.hasOnly([request.auth.uid]) &&
                       incoming().title is string &&
                       incoming().title.size() > 0 &&
                       incoming().title.size() <= 150 &&
                       incoming().createdAt == request.time;

      allow update: if isSignedIn() &&
                       isValidId(listId) &&
                       (
                         // 6. Solo puede agregarse a sí misma a una lista (memberIds crece exactamente en 1 con tu propio uid)
                         (
                           !(request.auth.uid in existing().memberIds) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberIds']) &&
                           incoming().memberIds.size() == existing().memberIds.size() + 1 &&
                           incoming().memberIds.hasAll(existing().memberIds) &&
                           incoming().memberIds.hasAll([request.auth.uid])
                         ) ||
                         // Dueña actualizando la lista
                         (
                           existing().ownerId == request.auth.uid &&
                           incoming().ownerId == existing().ownerId &&
                           incoming().createdAt == existing().createdAt
                         )
                       );

      // Solo la creadora borra la lista
      allow delete: if isSignedIn() &&
                       isValidId(listId) &&
                       existing().ownerId == request.auth.uid;

      match /options/{optionId} {
        allow read: if isListMember(listId);

        allow create: if isListMember(listId) &&
                         isValidId(optionId) &&
                         incoming().addedBy == request.auth.uid &&
                         incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100 &&
                         incoming().category in ['comer', 'cafe', 'salir', 'paseo'] &&
                         incoming().zone is string && incoming().zone.size() > 0 && incoming().zone.size() <= 100 &&
                         incoming().price in [1, 2, 3] &&
                         incoming().createdAt == request.time;

        allow delete: if isListMember(listId) &&
                         isValidId(optionId) &&
                         (
                           existing().addedBy == request.auth.uid ||
                           get(/databases/$(database)/documents/lists/$(listId)).data.ownerId == request.auth.uid
                         );
      }

      // 6. Cada persona tiene un solo voto por lista (el id del documento es su propio uid)
      match /votes/{voteUid} {
        allow read: if isListMember(listId);

        allow create, update: if isListMember(listId) &&
                                 voteUid == request.auth.uid &&
                                 isValidId(incoming().optionId) &&
                                 exists(/databases/$(database)/documents/lists/$(listId)/options/$(incoming().optionId));

        allow delete: if isListMember(listId) &&
                         voteUid == request.auth.uid;
      }
    }
  }
}
